{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cebada360 — procedencia técnica Data para inferencia",
  "$comment": "El cargador comprueba que todas las features seleccionadas estén documentadas, que el hash corresponda al CSV y que las fechas no excedan el corte.",
  "type": "object",
  "required": ["data_version", "features_file_sha256", "features"],
  "properties": {
    "data_version": {"$ref": "#/$defs/confirmed"},
    "features_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "features": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/feature"}}
  },
  "$defs": {
    "confirmed": {"type": "string", "minLength": 1, "pattern": "\\S", "allOf": [{"not": {"pattern": "^\\s*<"}}, {"not": {"pattern": "[Pp][Ee][Nn][Dd][Ii][Ee][Nn][Tt][Ee]"}}]},
    "feature": {
      "type": "object",
      "required": ["source", "sensor_or_dataset", "temporal_window", "transformation", "missing_value_policy", "uses_historical_information", "information_kind", "max_information_date"],
      "properties": {
        "source": {"$ref": "#/$defs/confirmed"},
        "sensor_or_dataset": {"$ref": "#/$defs/confirmed"},
        "temporal_window": {"$ref": "#/$defs/confirmed"},
        "transformation": {"$ref": "#/$defs/confirmed"},
        "missing_value_policy": {"$ref": "#/$defs/confirmed"},
        "uses_historical_information": {"type": "boolean"},
        "information_kind": {"enum": ["static", "temporal"]},
        "max_information_date": {"anyOf": [{"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, {"type": "null"}]},
        "historical_context": {"$ref": "#/$defs/confirmed"}
      },
      "allOf": [
        {"if": {"properties": {"uses_historical_information": {"const": true}}}, "then": {"required": ["historical_context"]}},
        {"if": {"properties": {"information_kind": {"const": "temporal"}}}, "then": {"properties": {"max_information_date": {"type": "string", "format": "date"}}}}
      ]
    }
  }
}

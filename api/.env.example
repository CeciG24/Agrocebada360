# Variables para exportar en el shell. La aplicación no carga .env automáticamente.
CEBADA_MODE=mock
CEBADA_LOG_LEVEL=INFO
# Para real: cambiar CEBADA_MODE=real y definir ambas rutas a una entrega verificada.
CEBADA_DATA=data/deploy/data
CEBADA_DELIVERY=data/deploy/delivery
# CORS: lista de orígenes separada por comas. Vacío = solo mismo origen.
# Ejemplo producción: CEBADA_ALLOWED_ORIGINS=https://tu-app.vercel.app
CEBADA_ALLOWED_ORIGINS=
